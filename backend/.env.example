APP_ENV=development
AUTO_CREATE_SCHEMA=true
LOCAL_BOOTSTRAP_ENABLED=true
DATABASE_URL=sqlite:///./paradox_cast.db
CORS_ORIGINS=http://localhost:5173

# Generate once and keep stable whenever encrypted provider credentials are saved:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PARADOX_CAST_CREDENTIAL_KEY=

# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://paradox_cast:CHANGE_ME@localhost:5432/paradox_cast

# Cloudflare R2 or another S3-compatible endpoint. For R2, endpoint and public
# endpoint are normally the same https://<ACCOUNT_ID>.r2.cloudflarestorage.com URL.
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_ENDPOINT=
R2_REGION=auto
R2_ADDRESSING_STYLE=path
R2_SIGNED_URL_TTL_SECONDS=300
R2_AUTO_CREATE_BUCKET=false

# Provider endpoints. API secrets are saved through /api/credentials, not here.
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_BASE_URL=
