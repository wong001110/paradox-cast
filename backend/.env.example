# Development defaults
APP_ENV=development
DATABASE_URL=sqlite:///./paradox_cast.db
CORS_ORIGINS=http://localhost:5173

# Required whenever users save provider credentials. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PARADOX_CAST_CREDENTIAL_KEY=

# Production PostgreSQL example (uncomment and supply the real values):
# DATABASE_URL=postgresql+psycopg://paradox_cast:CHANGE_ME@localhost:5432/paradox_cast

# Cloudflare R2 deployment contract. These are server-side only; never use VITE_ names.
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_SIGNED_URL_TTL_SECONDS=300

# Set only for each real provider you enable; the current demo uses mock and needs none.
DEEPSEEK_API_KEY=
